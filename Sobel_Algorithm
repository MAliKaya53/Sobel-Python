img = Image.open("vesikalik.jpg").convert("L")  # 'L' = grayscale
image = np.array(img)

plt.imshow(image, cmap='gray')
plt.title("Uploaded gray image")
plt.axis('off')
plt.show()


# Sobel filters
Gx = np.array([
    [-1, 0, 1],
    [-2, 0, 2],
    [-1, 0, 1]
])

Gy = np.array([
    [-1, -2, -1],
    [ 0,  0,  0],
    [ 1,  2,  1]
])

def apply_sobel(image, Gx, Gy):
    height, width = image.shape
    output = np.zeros((height, width))

    for i in range(1, height - 1):
        for j in range(1, width - 1):
            region = image[i-1:i+2, j-1:j+2]
            gx = np.sum(Gx * region)
            gy = np.sum(Gy * region)
            output[i, j] = np.sqrt(gx**2 + gy**2)

    # 0-255 normallize
    output = (output / output.max()) * 255
    return output.astype(np.uint8)

sobel_output = apply_sobel(image, Gx, Gy)

plt.figure(figsize=(10, 4))
plt.subplot(1, 2, 1)
plt.imshow(image, cmap='gray')
plt.title("Original image")
plt.axis('off')

plt.subplot(1, 2, 2)
plt.imshow(sobel_output, cmap='gray')
plt.title("Sobel Kenarları")
plt.axis('off')

plt.tight_layout()
plt.show()
